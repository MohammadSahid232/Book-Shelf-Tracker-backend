			"item": [
				{
					"name": "Get AI Book Recommendations",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"genrePreference\": \"Sci-Fi\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/ai/recommend",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"ai",
								"recommend"
							]
						},
						"description": "Generates 3 personalized book recommendations using Gemini AI based on user reading history and ratings."
					},
					"response": []
				},
